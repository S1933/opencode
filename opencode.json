{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.2",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "ask",
  "share": "disabled",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
    "tail_turns": 4,
    "preserve_recent_tokens": 20000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".idea/**",
      ".vscode/**",
      ".cache/**",
      "coverage/**",
      "var/cache/**",
      "var/log/**",
      "web/sites/*/files/**",
      "public/build/**",
      "public/assets/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "id_rsa*": "deny",
      "**/id_rsa*": "deny",
      "credentials*": "deny",
      "**/credentials*": "deny",
      "secrets*": "deny",
      "**/secrets*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "edit": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "ask",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git status*": "allow",
      "git show-ref*": "allow",
      "git branch*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git show --stat*": "allow",
      "git show --name-only*": "allow",
      "git show --summary*": "allow",
      "cat .env*": "deny",
      "cat **/.env*": "deny",
      "head .env*": "deny",
      "head **/.env*": "deny",
      "tail .env*": "deny",
      "tail **/.env*": "deny",
      "grep * .env*": "deny",
      "grep * **/.env*": "deny",
      "rg * .env*": "deny",
      "rg * **/.env*": "deny",
      "cat *.pem": "deny",
      "cat **/*.pem": "deny",
      "cat *.key": "deny",
      "cat **/*.key": "deny",
      "cat id_rsa*": "deny",
      "cat **/id_rsa*": "deny",
      "cat credentials*": "deny",
      "cat **/credentials*": "deny",
      "cat secrets*": "deny",
      "cat **/secrets*": "deny",
      "head *.pem": "deny",
      "head **/*.pem": "deny",
      "head *.key": "deny",
      "head **/*.key": "deny",
      "head id_rsa*": "deny",
      "head **/id_rsa*": "deny",
      "head credentials*": "deny",
      "head **/credentials*": "deny",
      "head secrets*": "deny",
      "head **/secrets*": "deny",
      "tail *.pem": "deny",
      "tail **/*.pem": "deny",
      "tail *.key": "deny",
      "tail **/*.key": "deny",
      "tail id_rsa*": "deny",
      "tail **/id_rsa*": "deny",
      "tail credentials*": "deny",
      "tail **/credentials*": "deny",
      "tail secrets*": "deny",
      "tail **/secrets*": "deny",
      "grep * *.pem": "deny",
      "grep * **/*.pem": "deny",
      "grep * *.key": "deny",
      "grep * **/*.key": "deny",
      "grep * id_rsa*": "deny",
      "grep * **/id_rsa*": "deny",
      "grep * credentials*": "deny",
      "grep * **/credentials*": "deny",
      "grep * secrets*": "deny",
      "grep * **/secrets*": "deny"
    }
  },
  "agent": {
    "ask": {
      "description": "Q&A read-only avec DeepSeek V4 Pro — questions rapides, exploration, recherche. Redirige vers docs/plan/build.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.0,
      "steps": 8,
      "prompt": "{file:./prompts/ask.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "webfetch": "ask",
        "websearch": "ask",
        "task": {
          "*": "deny",
          "build": "allow",
          "plan": "allow",
          "docs": "allow"
        }
      }
    },
    "build": {
      "description": "Default fast builder — plus petit diff sûr, vérification systématique, détour debug si la vérif échoue",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.2,
      "steps": 30,
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "ask",
        "webfetch": "ask",
        "websearch": "ask",
        "task": {
          "*": "deny"
        }
      }
    },
    "debug": {
      "description": "Bug diagnosis with MiniMax-M3 — reproduction autonome, cause racine, handoff vers plan",
      "mode": "primary",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1,
      "steps": 18,
      "prompt": "{file:./prompts/debug.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "ask",
        "webfetch": "ask",
        "websearch": "ask",
        "task": {
          "*": "deny"
        }
      }
    },
    "plan": {
      "description": "Default fast planner — plans exécutables, ancrés dans le code et les PRD/ADR",
      "mode": "primary",
      "model": "opencode-go/glm-5.2",
      "temperature": 0.1,
      "steps": 16,
      "prompt": "{file:./prompts/plan.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "webfetch": "ask",
        "websearch": "ask",
        "task": {
          "*": "deny"
        }
      }
    },
    "review": {
      "description": "Orchestrateur de revue — délègue à Salamèche, Carapuce, Bulbizarre et fusionne en consensus",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.0,
      "steps": 12,
      "prompt": "{file:./prompts/review.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "deny",
          "Salamèche": "allow",
          "Carapuce": "allow",
          "Bulbizarre": "allow",
          "plan": "allow",
          "build": "allow"
        }
      }
    },
    "Salamèche": {
      "description": "Deep reviewer focused on correctness and edge cases.",
      "mode": "subagent",
      "hidden": false,
      "model": "opencode-go/kimi-k2.7-code",
      "temperature": 0.1,
      "steps": 20,
      "prompt": "{file:./prompts/reviewer-salameche.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "Carapuce": {
      "description": "Balanced reviewer focused on maintainability.",
      "mode": "subagent",
      "hidden": false,
      "model": "opencode-go/glm-5.2",
      "temperature": 0.1,
      "steps": 16,
      "prompt": "{file:./prompts/reviewer-carapuce.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "Bulbizarre": {
      "description": "Fast reviewer focused on regressions.",
      "mode": "subagent",
      "hidden": false,
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1,
      "steps": 16,
      "prompt": "{file:./prompts/reviewer-bulbizarre.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "git": {
      "description": "Expert Git assistant for branches, diffs, history, merges, rebases, and conflicts",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.1,
      "steps": 20,
      "prompt": "{file:./prompts/git.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "ask",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "git blame*": "allow",
          "git remote*": "allow",
          "git reflog*": "allow",
          "git show --name-only*": "allow",
          "git show --name-status*": "allow",
          "git show --summary*": "allow",
          "git fetch*": "ask",
          "git pull*": "ask",
          "git merge*": "ask",
          "git rebase*": "ask",
          "git cherry-pick*": "ask",
          "git revert*": "ask",
          "git checkout*": "ask",
          "git switch*": "ask",
          "git restore*": "ask",
          "git reset*": "ask",
          "git clean*": "ask",
          "git stash*": "ask",
          "git stash list*": "allow",
          "git stash show*": "allow",
          "git add*": "ask",
          "git commit*": "ask",
          "git push*": "ask"
        }
      }
    },
    "docs": {
      "description": "Agent d'écriture — PRD, ADR, issues, documentation, README, PR descriptions depuis le diff courant",
      "mode": "all",
      "hidden": false,
      "model": "opencode-go/glm-5.2",
      "temperature": 0.2,
      "steps": 24,
      "prompt": "{file:./prompts/docs.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "ask",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "deny"
        }
      }
    },
    "orchestrator": {
      "description": "Orchestrateur de livraison — plan → build → verify → review → docs → git, boucle de correction avec cap à 3 itérations",
      "mode": "primary",
      "model": "opencode-go/glm-5.2",
      "temperature": 0.1,
      "steps": 60,
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "deny",
          "plan": "allow",
          "build": "allow",
          "debug": "allow",
          "review": "allow",
          "docs": "allow",
          "git": "allow"
        }
      }
    }
  }
}
